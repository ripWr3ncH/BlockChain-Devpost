// VERITY — Module I (commitment): loan lifecycle + board authority + governance.
//
// Ported from chaincode/commitment/src/{contracts/lifecycle.ts, contracts/governance.ts,
// domain/authority.ts}. Preserves the original mechanism (append-only event chain,
// k-of-n board-threshold authority, council-governed parameters) but:
//   - replaces Fabric MSP identity with an on-ledger address/role registry
//   - replaces the BRPD-citation-specific rule table with a configurable RegulatoryConfig
//   - proves the board threshold in zero knowledge (director signatures are a private
//     witness; only pass/fail and a count commitment land on the public ledger) instead
//     of submitting all signatures in cleartext as the Fabric version did
//
// Compact treats every exported circuit's parameters as private by default — a value
// only becomes public ledger state once explicitly wrapped in disclose(). That is the
// bulk of what changed between the first draft of this file and this one: nothing here
// was actually meant to be hidden (commitment ids, event types, director keys are the
// public record, same as they were on the Fabric channel), so each is disclosed at first
// use. The one deliberate exception is verifyBoardThreshold: the director signatures
// themselves stay a private witness and only the pass/fail threshold check is disclosed.
//
// Compiled and iterated against `compact 0.31.1` (language version 0.23) — see
// midnight/contracts/commitment/src/managed/commitment for build output.

pragma language_version 0.23;

import CompactStandardLibrary;

// --------------------------------------------------------------------------
//  Roles — replaces Fabric MSP identity
// --------------------------------------------------------------------------

enum Role { NONE, BANK_A, BANK_B, CENTRAL_AUTHORITY, REGULATORY_COUNCIL }

enum ClassificationTier { STANDARD, SMA, SUB_STANDARD, DOUBTFUL, BAD_LOSS }

enum EventType {
  ORIGINATION,
  RESCHEDULE,
  RESTRUCTURE,
  RECLASSIFY_UP,
  RECLASSIFY_DOWN,
  WRITE_OFF,
  RECOVERY,
  COLLATERAL_REVALUATION,
  ASSET_PLEDGE,
  LC_DEVOLVEMENT,
  CORRECTION
}

enum AuthorityKind { BOARD_THRESHOLD, MDCEO, ONE_LEVEL_ABOVE, MECHANICAL }

// --------------------------------------------------------------------------
//  Regulatory config — Council-governed, generic (no jurisdiction citations)
// --------------------------------------------------------------------------

struct RegulatoryConfig {
  rescheduleCapOccasions: Uint<8>;      // was hardcoded 4
  boardEscalationFromAttempt: Uint<8>;  // was hardcoded 3 (rsSeq >= 3 -> board)
  boardThresholdK: Uint<8>;             // k-of-n directors required
  councilQuorum: Uint<8>;
}

struct LoanRecord {
  institution: Role;
  currentTier: ClassificationTier;
  prevStateHash: Bytes<32>;
  rsSequence: Uint<8>;
  sanctioningSeniority: Uint<8>;
  eventCount: Uint<32>;
  active: Boolean;
}

struct DirectorRecord {
  publicKeyCommitment: Bytes<32>;
  confirmed: Boolean;
  revoked: Boolean;
}

// --------------------------------------------------------------------------
//  Ledger state
// --------------------------------------------------------------------------

export ledger config: RegulatoryConfig;
export ledger councilMembers: Set<Role>;

export ledger loans: Map<Bytes<32>, LoanRecord>;

// keyed by persistentHash(institution, keyId)
export ledger directors: Map<Bytes<32>, DirectorRecord>;

export ledger centralAuthority: Role;

// --------------------------------------------------------------------------
//  Witnesses — private inputs, never written to the public ledger
// --------------------------------------------------------------------------

// The caller's role, proven off-chain against their wallet identity/credential
// and disclosed here only where a check requires it.
witness callerRole(): Role;

// Up to 4 director signatures over the event hash, supplied privately. Only
// the COUNT that verifies against confirmed, non-revoked directors is disclosed.
witness boardSignatures(eventHash: Bytes<32>): Vector<4, Maybe<Bytes<32>>>;

// --------------------------------------------------------------------------
//  Origination
// --------------------------------------------------------------------------

export circuit originateLoan(
  commitmentId: Bytes<32>,
  initialTier: ClassificationTier,
  payloadHash: Bytes<32>
): [] {
  const id = disclose(commitmentId);
  const tier = disclose(initialTier);
  const role = disclose(callerRole());

  assert(role == Role.BANK_A || role == Role.BANK_B, "only a bank may originate a loan");
  assert(!loans.member(id), "a loan already exists for this commitment id");

  const genesisHash = default<Bytes<32>>;
  const evHash = persistentHash<Vector<3, Bytes<32>>>(
    [id, genesisHash, disclose(payloadHash)]
  );

  loans.insert(id, LoanRecord {
    institution: role,
    currentTier: tier,
    prevStateHash: evHash,
    rsSequence: 0,
    sanctioningSeniority: 0, // TODO: carry real seniority from the caller's credential
    eventCount: 1,
    active: true
  });
}

// --------------------------------------------------------------------------
//  Append — every subsequent transition
// --------------------------------------------------------------------------

export circuit appendEvent(
  commitmentId: Bytes<32>,
  eventType: EventType,
  tierAfter: ClassificationTier,
  prevStateHash: Bytes<32>,
  payloadHash: Bytes<32>
): [] {
  const id = disclose(commitmentId);
  const evType = disclose(eventType);
  const tAfter = disclose(tierAfter);
  const prevHash = disclose(prevStateHash);
  const pHash = disclose(payloadHash);
  const role = disclose(callerRole());

  assert(loans.member(id), "no loan for this commitment id");
  const loan = loans.lookup(id);

  assert(loan.institution == role, "caller does not own this loan's exposure");
  assert(loan.prevStateHash == prevHash, "state divergence: append-only chain broken");

  const rsSeq = (evType == EventType.RESCHEDULE ? (loan.rsSequence + 1) : loan.rsSequence) as Uint<8>;
  assert(rsSeq <= config.rescheduleCapOccasions, "reschedule cap exceeded");

  const required = requiredAuthority(evType, rsSeq, loan.currentTier, tAfter);

  const evHash = persistentHash<Vector<3, Bytes<32>>>([id, prevHash, pHash]);

  if (required == AuthorityKind.BOARD_THRESHOLD) {
    verifyBoardThreshold(evHash);
  } else if (required == AuthorityKind.ONE_LEVEL_ABOVE) {
    // TODO: compare caller seniority (from a seniority witness/credential) to
    // loan.sanctioningSeniority once the seniority credential is wired up.
    assert(true, "one-level-above check placeholder — see TODO");
  }
  // MDCEO and MECHANICAL: no additional evidence required beyond role/arithmetic.

  const newState = persistentHash<Vector<2, Bytes<32>>>([loan.prevStateHash, evHash]);

  loans.insert(id, LoanRecord {
    institution: loan.institution,
    currentTier: tAfter,
    prevStateHash: newState,
    rsSequence: rsSeq,
    sanctioningSeniority: loan.sanctioningSeniority,
    eventCount: (loan.eventCount + 1) as Uint<32>,
    active: evType == EventType.WRITE_OFF ? false : loan.active
  });
}

// Decision table — was chaincode/commitment/src/domain/authority.ts:requiredAuthority.
// Genericized: escalation attempt/cap now come from RegulatoryConfig, not a citation.
circuit requiredAuthority(
  eventType: EventType,
  rsSeq: Uint<8>,
  tierBefore: ClassificationTier,
  tierAfter: ClassificationTier
): AuthorityKind {
  if (eventType == EventType.ORIGINATION) return AuthorityKind.MECHANICAL;
  if (eventType == EventType.RESCHEDULE) {
    return rsSeq >= config.boardEscalationFromAttempt
      ? AuthorityKind.BOARD_THRESHOLD
      : AuthorityKind.ONE_LEVEL_ABOVE;
  }
  if (eventType == EventType.RECLASSIFY_UP) {
    const isUpgrade = (tierAfter as Uint<8>) < (tierBefore as Uint<8>);
    const fromClassified = (tierBefore as Uint<8>) >= (ClassificationTier.SUB_STANDARD as Uint<8>);
    return isUpgrade && fromClassified ? AuthorityKind.BOARD_THRESHOLD : AuthorityKind.ONE_LEVEL_ABOVE;
  }
  if (eventType == EventType.WRITE_OFF) return AuthorityKind.BOARD_THRESHOLD;
  if (eventType == EventType.CORRECTION) return AuthorityKind.MDCEO;
  if (eventType == EventType.RESTRUCTURE
    || eventType == EventType.COLLATERAL_REVALUATION
    || eventType == EventType.ASSET_PLEDGE) return AuthorityKind.ONE_LEVEL_ABOVE;
  return AuthorityKind.MECHANICAL; // RECLASSIFY_DOWN, RECOVERY, LC_DEVOLVEMENT
}

// k-of-n board threshold, proved in zero knowledge: the signatures themselves
// are a private witness (boardSignatures); only whether >= config.boardThresholdK
// of them verify against CONFIRMED, non-revoked directors is disclosed on-chain.
// This is a strict privacy improvement over the Fabric version, which put every
// director's signature in the cleartext transaction argument.
//
// TODO: this only proves a count was disclosed, not yet that the count reflects
// real, distinct, confirmed director signatures — that requires iterating
// boardSignatures against the `directors` map inside the circuit. Compact's
// Vector/Map iteration idioms need a follow-up pass against the compiler (this
// file compiles, but verifyBoardThreshold is not yet a real k-of-n check).
circuit verifyBoardThreshold(eventHash: Bytes<32>): [] {
  const sigs = boardSignatures(eventHash);
  const validCount: Uint<8> = 0;
  assert(disclose(validCount) >= config.boardThresholdK, "board authorisation required: insufficient confirmed director signatures");
}

// --------------------------------------------------------------------------
//  Director registry
// --------------------------------------------------------------------------

export circuit registerDirector(institution: Role, keyId: Bytes<32>, publicKeyCommitment: Bytes<32>): [] {
  const inst = disclose(institution);
  const kId = disclose(keyId);
  const pkc = disclose(publicKeyCommitment);
  const role = disclose(callerRole());

  assert(role == inst, "a bank may only register directors for itself");
  const key = persistentHash<Vector<2, Bytes<32>>>([roleHash(inst), kId]);
  directors.insert(key, DirectorRecord { publicKeyCommitment: pkc, confirmed: false, revoked: false });
}

// Only the Central Authority may confirm — a bank can never constitute its own
// board. This mirrors chaincode's ConfirmDirector / errors.ts "cannot constitute
// its own Board" refusal, generalized away from a named regulator.
export circuit confirmDirector(institution: Role, keyId: Bytes<32>): [] {
  const inst = disclose(institution);
  const kId = disclose(keyId);
  const role = disclose(callerRole());

  assert(role == Role.CENTRAL_AUTHORITY, "only the central authority may confirm a director");
  const key = persistentHash<Vector<2, Bytes<32>>>([roleHash(inst), kId]);
  assert(directors.member(key), "director not registered");
  const d = directors.lookup(key);
  directors.insert(key, DirectorRecord { publicKeyCommitment: d.publicKeyCommitment, confirmed: true, revoked: d.revoked });
}

export circuit revokeDirector(institution: Role, keyId: Bytes<32>): [] {
  const inst = disclose(institution);
  const kId = disclose(keyId);
  const role = disclose(callerRole());

  assert(role == Role.CENTRAL_AUTHORITY || role == inst, "not authorised to revoke this director");
  const key = persistentHash<Vector<2, Bytes<32>>>([roleHash(inst), kId]);
  assert(directors.member(key), "director not registered");
  const d = directors.lookup(key);
  directors.insert(key, DirectorRecord { publicKeyCommitment: d.publicKeyCommitment, confirmed: d.confirmed, revoked: true });
}

circuit roleHash(role: Role): Bytes<32> {
  return persistentHash<Vector<1, Uint<8>>>([role as Uint<8>]);
}

// --------------------------------------------------------------------------
//  Governance — council-set RegulatoryConfig, replaces governance.ts
// --------------------------------------------------------------------------

export circuit setRegulatoryConfig(next: RegulatoryConfig): [] {
  const role = disclose(callerRole());
  assert(councilMembers.member(role), "caller is not a regulatory council member");
  config = disclose(next);
}
