# Copy to .env and fill in. The seed is never committed.
#
# Generate a wallet by running the deploy with MIDNIGHT_WALLET_SEED unset — it
# prints a fresh seed and its unshielded address, then waits for you to fund the
# address at https://faucet.preview.midnight.network/ (captcha-gated, needs a browser).
MIDNIGHT_NETWORK=preview
MIDNIGHT_WALLET_SEED=
