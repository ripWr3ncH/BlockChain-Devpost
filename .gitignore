# ==========================================================================
#  Quorum — .gitignore
#
#  Committed BEFORE the first `npm install`. If node_modules/ or generated
#  crypto material ever lands in history, it stays there forever and every
#  clone carries it. Do not relax these rules without asking the team.
# ==========================================================================

# --- Regenerated by tooling -----------------------------------------------
node_modules/
.next/
dist/
build/
out/
coverage/
*.tsbuildinfo
.turbo/

# --- Generated crypto material — regenerated by network.sh, AND SECRET -----
network/organizations/peerOrganizations/
network/organizations/ordererOrganizations/
network/organizations/fabric-ca/*/
!network/organizations/fabric-ca/*/fabric-ca-server-config.yaml
**/msp/keystore/
network/organizations/directors.json
*.pem
*.key
!**/*.example.pem

# --- Runtime state — regenerated by up.sh and seed --------------------------
network/channel-artifacts/
network/system-genesis-block/
*.block
*.tx
*.tar.gz
ledger-snapshots/
.snapshots/
pgdata/
logs/
*.log

# --- Fabric tooling downloaded by bootstrap.sh -----------------------------
network/bin/
network/builders/
network/config/
network/install-fabric.sh
config/

# --- Large media — link to these, never commit them ------------------------
*.mp4
*.mov
*.avi

# --- Local environment -----------------------------------------------------
.env
.env.*
!.env.example

# --- Midnight — regenerated by `compact compile` / deploy, AND SECRET ------
midnight/contracts/*/src/managed/
midnight-level-db/
*.prover
*.verifier
# Local wallet/private-state store created by levelPrivateStateProvider
midnight/contracts/*/.midnight-level-db/
# Cached synced wallet state — derived from the seed, treat as secret
midnight/contracts/*/.wallet-cache.*.json
# deployment.<network>.json holds only a public contract address and IS committed
# deliberately — the bridge and the demo scripts read it. Never put a seed there.

# --- Editor / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/


ui-references/
# --- Production material, kept locally but out of the submission -----------
#  Everything below exists on disk and is deliberately not part of the repo:
#  competition scrape and internal notes, the pre-Midnight Fabric-era docs,
#  the reference deck and reference whitepaper, and the raw capture/edit
#  material for the demo video. None of it is needed to build or run Quorum.
requirements.txt
handover.txt
DEMO.md
VIDEO.md
VIDEO-SCRIPT.md
CAPTURE.md
RUNNING-ORDER.md
shots.md
recordings/
scripts/record-shots.mjs
slides/ReferenceSlide.pptx
slides/video/
whitePaper/VERITY_Whitepaper_v12.md
whitePaper/figures/*.png
whitePaper/figures/count.txt
CLAUDE.md
.claude/
